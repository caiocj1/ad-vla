# Copy to .env and fill in what you use. The scripts and tests load it with python-dotenv, and the
# configs read it with ${oc.env:NAME}. Use absolute paths.

# --- Outputs ------------------------------------------------------------------------------------
# Each run is written to $SAVE_PATH/<logging.version>/: checkpoints, resolved config, hf_ckpt/.
SAVE_PATH=/path/to/runs

# --- Hugging Face -------------------------------------------------------------------------------
HF_HOME=/path/to/huggingface_cache  # models; also the PhysicalAI-AV cache unless PHYSICAL_AI_CACHE_DIR is set
HF_TOKEN=                           # gated models and datasets (PhysicalAI-AV)
TOKENIZERS_PARALLELISM=false

# --- Dataset roots: only the datasets you use (docs/datasets.md) -----------------------------------
WAYMO_INDEX_PATH=/path/to/waymo_e2e_index    # made by scripts/utils/preprocess_waymo.py
OPENSCENE_DATA_ROOT=/path/to/navsim          # navsim_logs/ and sensor_blobs/
NUPLAN_MAPS_ROOT=/path/to/nuplan_maps        # NAVSIM's map API
NUSCENES_ROOT=/path/to/nuscenes
PHYSICAL_AI_CACHE_DIR=                       # optional, defaults to HF_HOME
KITSCENES_CACHE_DIR=                         # optional
NUPLANQA_IMAGES_ROOT=/path/to/nuplan_images  # part_<n>/<image token>.jpg

# --- Derived files that the dataset mixes and examples use (docs/datasets.md) ---------------------
ASSETS_DIR=/path/to/assets                   # indices/ and annotations/
INTENT_LABELS_DIR=/path/to/intent_labels     # intents_<dataset>_<split>.json
PHYSICAL_AI_TRAIN_CLIP_IDS=/path/to/train_clip_ids.txt
PHYSICAL_AI_VAL_CLIP_IDS=/path/to/ad-vla/resources/physical_ai/val_1000_clip_ids.txt
BEV_MODEL_CKPT_PATH=/path/to/simple_bev_checkpoint  # BEV forcing only

# --- Experiment tracking (optional) --------------------------------------------------------------
# TensorBoard is the default. For Comet, set these and logging.disable_comet=false.
COMET_API_KEY=
COMET_WORKSPACE=
COMET_PROJECT_NAME=

# --- Waymo E2E challenge submission (scripts/run_testing.py); lists are JSON -----------------------
WOD_SUB_AUTHORS=["First Author", "Second Author"]
WOD_SUB_AFFILIATION=
WOD_SUB_ACCOUNT_NAME=
WOD_SUB_UNIQUE_METHOD_NAME=
WOD_SUB_METHOD_LINK=
WOD_SUB_DESCRIPTION=
WOD_SUB_USES_PUBLIC_MODEL_PRETRAINING=true
WOD_SUB_PUBLIC_MODEL_NAMES=["Qwen3.5-2B"]
WOD_SUB_NUM_MODEL_PARAMETERS=2B
