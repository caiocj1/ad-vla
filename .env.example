# Preprocessed Waymo E2E index directory. See scripts/preprocess_waymo.py.
WAYMO_INDEX_PATH=/path/to/waymo_e2e_index

# Optional dataset roots used by NAVSIM and PhysicalAI-AV.
OPENSCENE_DATA_ROOT=/path/to/navsim
PHYSICAL_AI_CACHE_DIR=/path/to/physical_ai_cache

# Directory in which training runs and exported checkpoints are written.
OUTPUT_DIR=/path/to/training_outputs

# Required only by the BEV-forcing experiment.
BEV_MODEL_CKPT_PATH=/path/to/simple_bev_checkpoint

# Optional Hugging Face settings. HF_TOKEN is required for gated datasets.
HF_HOME=/path/to/huggingface_cache
HF_TOKEN=
TOKENIZERS_PARALLELISM=true

# Optional experiment tracking. Set logging.disable_comet=false to use these.
COMET_API_KEY=
COMET_WORKSPACE=
COMET_PROJECT_NAME=
